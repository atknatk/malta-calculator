# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*.xlsx
*.pdf

# Dark Factory — keep config and holdouts, ignore runtime artifacts
.dark-factory/sessions/
.dark-factory/.stop-signal
.dark-factory/.ralph-attempts.json
.dark-factory/.rate-limiter.json
.dark-factory/.circuit-breaker.json
.dark-factory/ralph.log
.dark-factory/ralph-monitor.log

# iOS / Xcode
ios-app/build/
ios-app/DerivedData/
ios-app/**/xcuserdata/
ios-app/**/*.xcuserstate
ios-app/**/.swiftpm/
ios-app/**/.build/
ios-app/fastlane/report.xml
ios-app/fastlane/Preview.html
ios-app/fastlane/screenshots/
ios-app/fastlane/test_output/
