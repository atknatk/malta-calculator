# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*.xlsx
*.pdf

# Dark Factory — keep config and holdouts, ignore runtime artifacts
.dark-factory/sessions/
.dark-factory/.stop-signal
.dark-factory/.ralph-attempts.json
.dark-factory/.rate-limiter.json
.dark-factory/.circuit-breaker.json
.dark-factory/ralph.log
.dark-factory/ralph-monitor.log

# iOS / Xcode
ios-app/build/
ios-app/DerivedData/
ios-app/**/xcuserdata/
ios-app/**/*.xcuserstate
ios-app/**/.swiftpm/xcode/
ios-app/**/.build/

# XcodeGen generated files
ios-app/*.xcodeproj
ios-app/*.xcworkspace

# Xcode build artifacts
*.ipa
*.dSYM.zip
*.dSYM
*.xcarchive
*.moved-aside
*.hmap
*.xccheckout
*.xcscmblueprint

# Xcode temporary files
*~.nib
*.swp

# Swift Package Manager
ios-app/Packages/*/Package.resolved
ios-app/.swiftpm/

# Fastlane
ios-app/fastlane/.env
ios-app/fastlane/.env.*
!ios-app/fastlane/.env.default
ios-app/fastlane/report.xml
ios-app/fastlane/Preview.html
ios-app/fastlane/screenshots/
ios-app/fastlane/test_output/
ios-app/fastlane/gym/
ios-app/fastlane/README.md

# Bundler (Fastlane)
ios-app/fastlane/vendor/
ios-app/fastlane/.bundle/
ios-app/fastlane/Gemfile.lock

# CocoaPods (not used, but prevent accidental inclusion)
ios-app/Pods/

# Carthage (not used, but prevent accidental inclusion)
ios-app/Carthage/

# Xcode Playground
ios-app/timeline.xctimeline
ios-app/playground.xcworkspace
