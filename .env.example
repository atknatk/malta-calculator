# Malta Salary Calculator API Token
# Generate a secure token and set it here for API authentication
SALARY_API_TOKEN=your-secure-api-token-here
# Client-side token (must match SALARY_API_TOKEN)
NEXT_PUBLIC_SALARY_API_TOKEN=your-secure-api-token-here

# AWS S3 Configuration (for logo and PDF uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=eu-central-1
AWS_S3_BUCKET=your-bucket-name

# Google AdSense (optional) — display ads stay OFF unless these are set.
# Ads only render on niche bank-rate pages (see docs/MONETIZATION_PLAN.md, Kanal C).
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_ADSENSE_SLOT_RATES=xxxxxxxxxx

# Lead capture (partner referrals) — OFF by default. Turn on only after a
# broker/advisor partner deal + privacy review. Requires the `leads` table
# (docs/migrations/002_leads.sql) and SUPABASE_SERVICE_ROLE_KEY.
# NEXT_PUBLIC_LEADGEN_ENABLED=true

# Stripe Configuration
# Use sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_BASIC_PRICE_ID=price_your-basic-price-id
STRIPE_PRO_PRICE_ID=price_your-pro-price-id

# Cloudflare Turnstile (captcha on payslip QR verification and employee PIN page)
# https://dash.cloudflare.com/?to=/:account/turnstile — if unset, the captcha is skipped
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# HMAC secret for payslip access cookies (PIN / verification). Falls back to
# SUPABASE_SERVICE_ROLE_KEY when unset. Generate with: openssl rand -base64 32
PAYSLIP_ACCESS_SECRET=
# Optional: comma-separated hostnames accepted from Turnstile (default: maltacalculator.com,www.maltacalculator.com)
TURNSTILE_HOSTNAMES=

# Payslip PDF archive (Cloudflare R2 + Browser Rendering). When any of these is
# unset, archiving is skipped and issuing works as before.
# R2 bucket with a Bucket Lock retention rule; S3 API token scoped to that bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PAYSLIP_BUCKET=
# API token with "Browser Rendering - Edit" permission
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BROWSER_RENDERING_TOKEN=
# Public site URL Cloudflare opens to render the PDF (defaults to the Vercel production URL)
PAYSLIP_RENDER_BASE_URL=https://maltacalculator.com
# Vercel Cron retries failed archives daily; generate with: openssl rand -base64 32
CRON_SECRET=
