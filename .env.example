# Malta Salary Calculator API Token
# Generate a secure token and set it here for API authentication
SALARY_API_TOKEN=your-secure-api-token-here
# Client-side token (must match SALARY_API_TOKEN)
NEXT_PUBLIC_SALARY_API_TOKEN=your-secure-api-token-here

# AWS S3 Configuration (for logo and PDF uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=eu-central-1
AWS_S3_BUCKET=your-bucket-name
