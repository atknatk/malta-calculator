{
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "hsl",
        "components": [220, 20, 8]
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "hsl",
        "components": [40, 20, 96]
      }
    },
    "card": {
      "$value": {
        "colorSpace": "hsl",
        "components": [220, 20, 10]
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "hsl",
        "components": [220, 15, 15]
      }
    },
    "muted-foreground": {
      "$value": {
        "colorSpace": "hsl",
        "components": [40, 10, 70]
      }
    },
    "border": {
      "$value": {
        "colorSpace": "hsl",
        "components": [220, 15, 20]
      }
    },
    "input": {
      "$value": {
        "colorSpace": "hsl",
        "components": [220, 15, 42]
      }
    },
    "primary": {
      "$value": {
        "colorSpace": "hsl",
        "components": [38, 92, 48]
      }
    },
    "primary-foreground": {
      "$value": {
        "colorSpace": "hsl",
        "components": [20, 14, 8]
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "hsl",
        "components": [199, 89, 55]
      }
    },
    "secondary-foreground": {
      "$value": {
        "colorSpace": "hsl",
        "components": [220, 20, 8]
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "hsl",
        "components": [220, 15, 18]
      }
    },
    "destructive": {
      "$value": {
        "colorSpace": "hsl",
        "components": [0, 72, 58]
      }
    },
    "destructive-foreground": {
      "$value": {
        "colorSpace": "hsl",
        "components": [220, 20, 8]
      }
    },
    "ring": {
      "$value": {
        "colorSpace": "hsl",
        "components": [38, 92, 55]
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2902, 0.8706, 0.502],
        "hex": "#4ade80"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9843, 0.5725, 0.2353],
        "hex": "#fb923c"
      }
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9725, 0.4431, 0.4431],
        "hex": "#f87171"
      }
    },
    "glass-bg": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0, 0.0, 0.0],
        "hex": "#000000",
        "alpha": 0.4
      }
    },
    "glass-border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 1.0, 1.0],
        "hex": "#ffffff",
        "alpha": 0.1
      }
    },
    "glass-strong-bg": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0, 0.0, 0.0],
        "hex": "#000000",
        "alpha": 0.6
      }
    },
    "glass-strong-border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 1.0, 1.0],
        "hex": "#ffffff",
        "alpha": 0.15
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0.0, 0.0, 0.0],
          "hex": "#000000",
          "alpha": 0.5
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 25,
          "unit": "px"
        },
        "blur": {
          "value": 50,
          "unit": "px"
        },
        "spread": {
          "value": -12,
          "unit": "px"
        }
      }
    },
    "glow": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0.9608, 0.651, 0.1373],
          "hex": "#f5a623",
          "alpha": 0.15
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 0,
          "unit": "px"
        },
        "blur": {
          "value": 60,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  }
}
